# ──────────────────────────────────────────────────────────────────
# Pack&Go Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────

# Server port
PORT=5001

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/packandgo
# Atlas:  mongodb+srv://<username>:<password>@cluster0.mongodb.net/packandgo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/packandgo

# Node environment: development | production
NODE_ENV=development

# Frontend origin allowed by CORS (also supports localhost:5174 automatically)
CLIENT_URL=http://localhost:5173

# JWT secret — replace with a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Razorpay payment gateway
# Test keys start with rzp_test_, live keys start with rzp_live_
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Allow POST /api/database/seed (wipes and reseeds all data) when NODE_ENV=production.
# Leave unset unless you really mean it.
# ALLOW_DB_RESEED=true

# Comma-separated emails with admin rights (review Move Captain applications).
# The seeded admin@packandgo.in account is an admin too.
ADMIN_EMAILS=

# Public URL of the frontend — used in email links (verify email, reset password)
# CLIENT_URL is set above.

# ── Email (SMTP) ── required in production for email verification, password reset
# and booking emails. Without them nothing is sent (the app says so) and, in development
# only, verify/reset links are shown in the app instead. Passwords are never logged.
#   Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com
#            SMTP_PASS=<16-character App Password from Google Account → Security → App passwords>
#            (a normal Gmail password will be rejected; 2-Step Verification must be on)
#   Others:  use your provider's host; port 587 uses STARTTLS, 465 uses TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: force TLS on/off (default: TLS for 465, STARTTLS for 587)
SMTP_SECURE=
# Must be an address your SMTP account may send as (Gmail: the same address as SMTP_USER)
EMAIL_FROM="Pack&Go <no-reply@yourdomain.in>"
# Never email these domains (comma list). Default outside production: packandgo.in (the demo
# accounts' domain). Leave unset in production unless you need it.
EMAIL_SUPPRESS_DOMAINS=
# Check delivery for real:  npm run email:test -- you@example.com

# ── SMS (Twilio) ── without these, SMS are printed to the server log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Razorpay webhook ── Dashboard → Settings → Webhooks → URL https://<your-api>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── AI (PackBot, AI room scan, voice inventory) ── set ONE key; the first found is used,
# or choose explicitly with AI_PROVIDER = gemini | groq | xai | anthropic.
# Free:  Google Gemini — https://aistudio.google.com/apikey  (understands photos — recommended;
#        default model gemini-3.5-flash-lite — fast on the free tier — with automatic backups)
GEMINI_API_KEY=
# Free:  Groq (Llama) — https://console.groq.com/keys  (fast; weaker on photos)
GROQ_API_KEY=
# Paid:  xAI Grok — https://console.x.ai
XAI_API_KEY=
# Paid:  Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# AI_PROVIDER=
# AI_MODEL=            # override the text model for gemini/groq/xai
# AI_VISION_MODEL=     # override the photo model for gemini/groq/xai

# GST rate applied to fares (default 0.18)
# GST_RATE=0.18

# Demo accounts (admin@packandgo.in, captain.manju@…, demo@… — password demo1234) are created
# automatically in development only. NEVER enable this on a public server.
# SEED_DEMO_ACCOUNTS=false
