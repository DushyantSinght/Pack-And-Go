# ──────────────────────────────────────────────────────────────────
# Pack&Go Backend — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────

# Server port
PORT=5001

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/packandgo
# Atlas:  mongodb+srv://<username>:<password>@cluster0.mongodb.net/packandgo?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/packandgo

# Node environment: development | production
NODE_ENV=development

# Frontend origin allowed by CORS (also supports localhost:5174 automatically)
CLIENT_URL=http://localhost:5173

# JWT secret — replace with a long random string in production
# Generate one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Razorpay payment gateway
# Test keys start with rzp_test_, live keys start with rzp_live_
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Allow POST /api/database/seed (wipes and reseeds all data) when NODE_ENV=production.
# Leave unset unless you really mean it.
# ALLOW_DB_RESEED=true

# Comma-separated emails with admin rights (review Move Captain applications).
# The seeded admin@packandgo.in account is an admin too.
ADMIN_EMAILS=

# Public URL of the frontend — used in email links (verify email, reset password)
# CLIENT_URL is set above.

# ── Email (SMTP) ── without these, emails are printed to the server log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Pack&Go <no-reply@yourdomain.in>"

# ── SMS (Twilio) ── without these, SMS are printed to the server log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Razorpay webhook ── Dashboard → Settings → Webhooks → URL https://<your-api>/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ── Claude (PackBot + AI room scan) ── https://console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# GST rate applied to fares (default 0.18)
# GST_RATE=0.18

# Demo accounts (admin@packandgo.in, captain.manju@…, demo@… — password demo1234) are created
# automatically in development only. NEVER enable this on a public server.
# SEED_DEMO_ACCOUNTS=false
